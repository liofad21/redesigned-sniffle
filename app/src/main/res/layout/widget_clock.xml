<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:gravity="center" android:orientation="vertical" android:padding="16dp">
    <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:format12Hour="hh:mm" android:format24Hour="HH:mm" android:textColor="#FF2A2A" android:textSize="56sp" android:fontFamily="serif" android:textStyle="bold" android:shadowColor="#99FF0000" android:shadowDx="0" android:shadowDy="0" android:shadowRadius="12" />
    <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:format12Hour="EEEE, d MMMM" android:format24Hour="EEEE, d MMMM" android:textColor="#C9C9D1" android:textSize="16sp" />
</LinearLayout>
